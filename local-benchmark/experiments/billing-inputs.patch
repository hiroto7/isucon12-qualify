@@ -0,0 +1,30 @@
+package isuports
+
+import "context"
+
+func billingTenants(ctx context.Context, db dbOrTx, beforeID int64) ([]TenantRow, error) {
+	rows := make([]TenantRow, 0, 10)
+	query := "SELECT * FROM tenant ORDER BY id DESC LIMIT 10"
+	var args []interface{}
+	if beforeID != 0 {
+		query = "SELECT * FROM tenant WHERE id < ? ORDER BY id DESC LIMIT 10"
+		args = []interface{}{beforeID}
+	}
+	if err := db.SelectContext(ctx, &rows, query, args...); err != nil {
+		return nil, err
+	}
+	return rows, nil
+}
+
+func invalidateBillingForVisit(ctx context.Context, db dbOrTx, tenantID int64, competitionID string, createdAt int64) error {
+	// Reload after durable visit commit: a concurrent/repeated finish may have
+	// advanced the cutoff since the ranking handler's initial competition read.
+	comp, err := retrieveCompetition(ctx, db, competitionID)
+	if err != nil {
+		return err
+	}
+	if !comp.FinishedAt.Valid || createdAt <= comp.FinishedAt.Int64 {
+		invalidateBilling(tenantID, competitionID)
+	}
+	return nil
+}
