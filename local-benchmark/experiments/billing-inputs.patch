@@ -0,0 +1,57 @@
+package isuports
+
+import (
+	"context"
+	"testing"
+
+	"github.com/jmoiron/sqlx"
+)
+
+func TestBillingTenantPagesAndVisitCutoff(t *testing.T) {
+	db := sqlx.MustOpen("sqlite3", ":memory:")
+	db.SetMaxOpenConns(1)
+	defer db.Close()
+	db.MustExec(`CREATE TABLE tenant(id INTEGER PRIMARY KEY,name TEXT,display_name TEXT,created_at INTEGER,updated_at INTEGER);
+ CREATE TABLE competition(id TEXT PRIMARY KEY,tenant_id INTEGER,title TEXT,finished_at INTEGER,created_at INTEGER,updated_at INTEGER);
+ INSERT INTO competition VALUES('cutoff',706,'C',100,1,100);`)
+	for i := 1; i <= 23; i++ {
+		db.MustExec("INSERT INTO tenant VALUES(?,'a','A',0,0)", i)
+	}
+	ctx := context.Background()
+	for _, test := range []struct {
+		before int64
+		count  int
+		first  int64
+	}{{0, 10, 23}, {14, 10, 13}, {4, 3, 3}, {-1, 0, 0}} {
+		rows, err := billingTenants(ctx, db, test.before)
+		if err != nil || len(rows) != test.count {
+			t.Fatal(rows, err)
+		}
+		if len(rows) > 0 && rows[0].ID != test.first {
+			t.Fatal(rows)
+		}
+	}
+	state := billingState(competitionCacheKey{706, "cutoff"})
+	state.report = &BillingReport{VisitorCount: 1}
+	state.finishedAt = 100
+	if err := invalidateBillingForVisit(ctx, db, 706, "cutoff", 101); err != nil {
+		t.Fatal(err)
+	}
+	if state.report == nil {
+		t.Fatal("late visit invalidated fixed billing")
+	}
+	if err := invalidateBillingForVisit(ctx, db, 706, "cutoff", 100); err != nil {
+		t.Fatal(err)
+	}
+	if state.report != nil {
+		t.Fatal("equal-cutoff visit retained stale billing")
+	}
+	state.report = &BillingReport{}
+	db.MustExec("UPDATE competition SET finished_at=200 WHERE id='cutoff'")
+	if err := invalidateBillingForVisit(ctx, db, 706, "cutoff", 150); err != nil {
+		t.Fatal(err)
+	}
+	if state.report != nil {
+		t.Fatal("advanced finish cutoff was ignored")
+	}
+}
