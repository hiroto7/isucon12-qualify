diff --git a/webapp/go/precompute.go b/webapp/go/precompute.go
new file mode 100644
index 0000000..6e78449
--- /dev/null
+++ b/webapp/go/precompute.go
@@ -0,0 +1,89 @@
+package isuports
+
+import (
+	"context"
+	"sync"
+)
+
+var newCompetitions sync.Map
+
+func resetNewCompetitions() {
+	newCompetitions.Range(func(key, _ interface{}) bool { newCompetitions.Delete(key); return true })
+}
+
+type seedVisit struct {
+	TenantID      int64  `db:"tenant_id"`
+	CompetitionID string `db:"competition_id"`
+	PlayerID      string `db:"player_id"`
+	CreatedAt     int64  `db:"created_at"`
+}
+
+func seededBilling(comp CompetitionRow, scores map[string]int64, visits []seedVisit) BillingReport {
+	var visitors int64
+	for _, visit := range visits {
+		if visit.CreatedAt <= comp.FinishedAt.Int64 {
+			if _, scored := scores[visit.PlayerID]; !scored {
+				visitors++
+			}
+		}
+	}
+	players := int64(len(scores))
+	return BillingReport{CompetitionID: comp.ID, CompetitionTitle: comp.Title,
+		PlayerCount: players, VisitorCount: visitors, BillingPlayerYen: players * 100,
+		BillingVisitorYen: visitors * 10, BillingYen: players*100 + visitors*10}
+}
+
+// Called only before listening, or during the benchmark's exclusive initialize.
+// Canonical durable rows remain the source of truth across process restarts.
+func warmDurableSnapshots(ctx context.Context) error {
+	var visits []seedVisit
+	if err := adminDB.SelectContext(ctx, &visits, "SELECT tenant_id,competition_id,player_id,MIN(created_at) AS created_at FROM visit_history GROUP BY tenant_id,competition_id,player_id"); err != nil {
+		return err
+	}
+	byCompetition := make(map[competitionCacheKey][]seedVisit)
+	for _, visit := range visits {
+		key := competitionCacheKey{visit.TenantID, visit.CompetitionID}
+		byCompetition[key] = append(byCompetition[key], visit)
+		firstVisits.Store(visitCacheKey{visit.TenantID, visit.CompetitionID, visit.PlayerID}, &firstVisit{known: true, at: visit.CreatedAt})
+	}
+	var tenants []TenantRow
+	if err := adminDB.SelectContext(ctx, &tenants, "SELECT * FROM tenant"); err != nil {
+		return err
+	}
+	for _, tenant := range tenants {
+		tenantsByName.Store(tenant.Name, tenant)
+		db, err := connectToTenantDB(tenant.ID)
+		if err != nil {
+			return err
+		}
+		var players []PlayerRow
+		if err := db.SelectContext(ctx, &players, "SELECT * FROM player"); err != nil {
+			return err
+		}
+		for _, player := range players {
+			db.metadata("SELECT * FROM player WHERE id = ?", player.ID).value = player
+		}
+		var competitions []CompetitionRow
+		if err := db.SelectContext(ctx, &competitions, "SELECT * FROM competition"); err != nil {
+			return err
+		}
+		for _, comp := range competitions {
+			db.metadata("SELECT * FROM competition WHERE id = ?", comp.ID).value = comp
+			if _, err := competitionRanks(ctx, db.DB, tenant.ID, comp.ID); err != nil {
+				return err
+			}
+			scores, err := competitionScores(ctx, db, tenant.ID, comp.ID)
+			if err != nil {
+				return err
+			}
+			if !comp.FinishedAt.Valid {
+				continue
+			}
+			report := seededBilling(comp, scores, byCompetition[competitionCacheKey{tenant.ID, comp.ID}])
+			state := billingState(competitionCacheKey{tenant.ID, comp.ID})
+			state.finishedAt = comp.FinishedAt.Int64
+			state.report = &report
+		}
+	}
+	return nil
+}
