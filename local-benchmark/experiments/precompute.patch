+++ b/webapp/go/precompute_test.go
@@ -0,0 +1,50 @@
+package isuports
+
+import (
+	"context"
+	"database/sql"
+	"fmt"
+	"testing"
+
+	"github.com/jmoiron/sqlx"
+)
+
+func TestSeedBillingCutoffAndScorerPrecedence(t *testing.T) {
+	comp := CompetitionRow{ID: "c", Title: "C", FinishedAt: sql.NullInt64{Int64: 100, Valid: true}}
+	report := seededBilling(comp, map[string]int64{"p": 1, "q": 2}, []seedVisit{
+		{PlayerID: "p", CreatedAt: 10}, {PlayerID: "early", CreatedAt: 99},
+		{PlayerID: "equal", CreatedAt: 100}, {PlayerID: "late", CreatedAt: 101},
+	})
+	if report.PlayerCount != 2 || report.VisitorCount != 2 || report.BillingYen != 220 {
+		t.Fatal(report)
+	}
+}
+
+type noVisitLookup struct{ *sqlx.DB }
+
+func (db noVisitLookup) GetContext(context.Context, interface{}, string, ...interface{}) error {
+	return fmt.Errorf("unexpected historical lookup for new competition")
+}
+
+func TestNewCompetitionVisitSkipsOnlyHistoricalLookup(t *testing.T) {
+	db := sqlx.MustOpen("sqlite3", ":memory:")
+	db.SetMaxOpenConns(1)
+	defer db.Close()
+	db.MustExec("CREATE TABLE visit_history(player_id TEXT,tenant_id INTEGER,competition_id TEXT,created_at INTEGER,updated_at INTEGER)")
+	key := competitionCacheKey{702, "new"}
+	newCompetitions.Store(key, true)
+	defer newCompetitions.Delete(key)
+	changed, err := recordFirstVisit(context.Background(), noVisitLookup{db}, 702, "new", "p", 100)
+	if err != nil || !changed {
+		t.Fatal(changed, err)
+	}
+	var count int
+	db.Get(&count, "SELECT COUNT(*) FROM visit_history")
+	if count != 1 {
+		t.Fatal("durable first visit skipped")
+	}
+	changed, err = recordFirstVisit(context.Background(), noVisitLookup{db}, 702, "new", "p", 50)
+	if err != nil || !changed {
+		t.Fatal("earlier clock not recorded", changed, err)
+	}
+}
